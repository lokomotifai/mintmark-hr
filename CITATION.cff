  given-names: Fatih
  alias: fatihguner
repository-code: https://github.com/lokomotifai/mintmark-hr
license: Apache-2.0
keywords:
- synthetic data
- Turkish
- human resources
- payroll
- KVKK
- named entity recognition
- special category data
