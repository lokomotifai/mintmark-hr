# Owner-only planning material. Never enters git history.
# Repository standard section 7.1: owner-only planning documents are
# gitignored by name.
PLAN.md
briefs/
research/
corpus/

# Build and run output
dist/
build/
*.egg-info/

# Environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store

# Reference datasets are release artifacts, never committed (FD-05)
# Only samples/ is committed, bounded per the pack contract.
*.jsonl
!samples/*.jsonl
!tests/**/*.jsonl
